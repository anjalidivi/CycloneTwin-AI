# CycloneTwin AI Platform Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development

# Storage paths
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
MAX_UPLOAD_SIZE_MB=25

# Optional Custom Map Tile Provider (Leaflet defaults to Esri World Dark Gray Canvas with zero watermarks)
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; Mapbox &copy; OpenStreetMap
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Optional external satellite telemetry credentials (placeholders)
NOAA_API_KEY=
ISRO_MOSDAC_TOKEN=
