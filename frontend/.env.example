# Frontend Map & API Configuration
VITE_API_URL=/api

# Optional Custom Map Tile Provider (defaults to Esri World Dark Gray Canvas with zero watermarks)
# Example for custom Mapbox or Stadia provider:
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_KEY
# VITE_MAP_ATTRIBUTION=&copy; Mapbox &copy; OpenStreetMap
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
